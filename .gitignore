### ===== C++ (github/gitignore 官方 C++.gitignore) =====
# Prerequisites
*.d

# 编译对象文件
*.slo
*.lo
*.o
*.obj

# 预编译头
*.gch
*.pch

# 动态库
*.so
*.dylib
*.dll

# 静态库
*.lai
*.la
*.a
*.lib

# 可执行文件
*.exe
*.out
*.app

### ===== Visual Studio (github/gitignore 官方 VisualStudio.gitignore 精简) =====
# 用户级文件
*.suo
*.user
*.userosscache
*.sln.docstates

# 构建输出
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/

# VS 生成文件
*.ilk
*.pdb
*.ipdb
*.pgc
*.pgd
*.tmp
*.log

# VC++ 缓存
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb

# VS 2015+ 缓存/选项目录
.vs/

### ===== VS Code（官方模板内嵌部分）=====
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

.history/
*.vsix

### ===== 你项目实际会用到的部分（非官方模板，按需追加）=====
# CMake / Ninja
build/
build*/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
CMakeUserPresets.json
.ninja_deps
.ninja_log
build.ninja

# Conan 2
conan.lock
conaninfo.txt
conanbuildinfo.*
.conan2/

# 系统/编辑器杂项
.DS_Store
Thumbs.db

compile_commands.json
